NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required in Vercel for the daily Supabase heartbeat cron. Use a random
# production secret of at least 16 characters.
CRON_SECRET=
# Server-only. Required for private dataset and reference-resource artifacts;
# never expose it through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datasets
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Escaped "\n" private-key newlines are supported.
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=

# Use a Supabase Postgres connection string. The Supabase pooler URL is preferred
# for deployed serverless functions; include sslmode=require when Supabase provides it.
DATABASE_URL=
# Required for certificate-verified non-local production database connections.
# Store the PEM value as literal newlines or escaped \\n sequences.
DATABASE_SSL_CA=

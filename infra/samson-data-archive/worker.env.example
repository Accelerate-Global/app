TZ=America/Los_Angeles
DATA_ARCHIVE_PROJECT_REF=replace-with-project-ref
DATA_ARCHIVE_STATE_DIR=/var/lib/ax-data-archive
DATA_ARCHIVE_STAGING_DIR=/var/cache/ax-data-archive
DATA_ARCHIVE_TREE_DIR=/srv/ax-data-archive/current
DATA_ARCHIVE_RESTIC_REPOSITORY=/srv/ax-data-archive/restic
DATA_ARCHIVE_ARCHIVE_LIMIT_BYTES=53687091200
DATA_ARCHIVE_ARCHIVE_WARNING_BYTES=42949672960
DATA_ARCHIVE_ARCHIVE_CRITICAL_BYTES=48318382080
DATA_ARCHIVE_CHECK_SUBSET=5%
DATA_ARCHIVE_RECEIPT_URL=https://data.accelerateglobal.org/api/internal/archive-receipts
DATA_ARCHIVE_RECEIPT_KEY_FILE=/etc/ax-data-archive/secrets/receipt-key
DATA_ARCHIVE_SUPABASE_URL=https://replace-with-project-ref.supabase.co
DATA_ARCHIVE_STORAGE_AUTH_EMAIL_FILE=/etc/ax-data-archive/secrets/storage-email
DATA_ARCHIVE_STORAGE_AUTH_PASSWORD_FILE=/etc/ax-data-archive/secrets/storage-password
DATA_ARCHIVE_SUPABASE_ANON_KEY_FILE=/etc/ax-data-archive/secrets/supabase-anon-key
DATA_ARCHIVE_DATASET_BUCKET=datasets
DATA_ARCHIVE_ARTIFACT_BUCKET=api-connection-artifacts
DATA_ARCHIVE_ALERT_STATE_FILE=/var/lib/ax-data-archive/direct-alerts.json
DATA_ARCHIVE_LAST_SUCCESS_FILE=/var/lib/ax-data-archive/last-success
PGPASSFILE=/etc/ax-data-archive/secrets/pgpass
PGHOST=replace-with-direct-database-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=data_archive_backup_reader
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ax-data-archive/supabase-root-2021.crt
AWS_ACCESS_KEY_ID=replace-with-project-ref
AWS_ENDPOINT_URL_S3=https://replace-with-project-ref.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=us-east-1
RESTIC_PASSWORD_FILE=/etc/ax-data-archive/secrets/restic-password
DATA_ARCHIVE_RESEND_API_KEY_FILE=/etc/ax-data-archive/secrets/resend-api-key
DATA_ARCHIVE_ALERT_FROM_FILE=/etc/ax-data-archive/secrets/alert-from
DATA_ARCHIVE_ALERT_RECIPIENT_FILE=/etc/ax-data-archive/secrets/alert-recipient
DATA_ARCHIVE_ALERT_DETAILS_URL=https://data.accelerateglobal.org

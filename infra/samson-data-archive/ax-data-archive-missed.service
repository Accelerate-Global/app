[Unit]
Description=Detect missed AX Online recovery archive runs
After=network-online.target

[Service]
Type=oneshot
User=axarchive
Group=axarchive
WorkingDirectory=/opt/ax-data-archive
EnvironmentFile=/etc/ax-data-archive/worker.env
ExecStart=/usr/local/bin/node --jitless --import tsx scripts/samson-data-archive.ts check-missed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ax-data-archive
MemoryDenyWriteExecute=true
TimeoutStartSec=5m
